# Docker Compose variables only. Copy to .env at repo root and fill in.
# App secrets (LLM keys, GOOGLE_CLIENT_ID, SESSION_SECRET) stay in backend/.env —
# see backend/.env.example.

# --- Backend host port ---
# 3878 is a DuSu-specific port unlikely to collide with other local dev
# servers (avoids the usual 3000/5000/8000/8080/9000 defaults). Change this
# if it ever conflicts on your machine — the container's internal port stays 8000.
BACKEND_PORT=3878

# --- Postgres (THE database — this stack's own, no external provider) ---
# docker-compose.yml builds the backend's DATABASE_URL from these three values,
# so they are the single source of truth for the database credentials.
# Use a long random POSTGRES_PASSWORD; the database is not published to the host,
# but the value ends up in the connection string either way.
#
# NOTE: these are read only when the `pgdata` volume is FIRST created. Changing
# POSTGRES_PASSWORD later does not change the password inside an existing volume
# — keep it, or wipe and start over with `docker compose down -v` (destroys all
# data; export it first with backend/scripts/migrate_db.py).
POSTGRES_USER=dusu
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=dusu

# dusu.ruralrootcloud.com is routed by the host's own cloudflared (already
# running as a systemd service on this box) straight to
# http://localhost:${BACKEND_PORT}. No token/tunnel var needed in this repo —
# see cloudflare/TUNNEL.md for the one-time dashboard route setup.
