# Docker Compose variables only. Copy to .env at repo root and fill in.
# App secrets (LLM keys, GOOGLE_CLIENT_ID, SESSION_SECRET) stay in backend/.env —
# see backend/.env.example.

# --- Backend host port ---
# 3878 is a DuSu-specific port unlikely to collide with other local dev
# servers (avoids the usual 3000/5000/8000/8080/9000 defaults). Change this
# if it ever conflicts on your machine — the container's internal port stays 8000.
BACKEND_PORT=3878

# --- MongoDB (THE database - the shared `rooted-mongo`, not a container of this stack) ---
# DuSu's data lives in the database `dusu` of the shared MongoDB (the one RootEd and Yahin also use; replica set rs0, on the external docker network
# `rooted-shared-net`), under a user scoped to that one database. The user was made once with
#   ~/Desktop/RootEd_ALL/shared-services/scripts/create-app-db.sh dusu prod --no-bucket
# which wrote its password to ~/Desktop/RootEd_ALL/shared-services/creds/dusu-prod.env (mode 600). Put that password here (letters and digits only, so it needs no
# escaping in the URI). docker-compose.yml builds the backend's MONGODB_URI from it:
#   mongodb://dusu_prod_app:<DUSU_MONGO_PASSWORD>@rooted-mongo:27017/dusu?replicaSet=rs0&authSource=dusu
# Never `source` shared-services' own .env in a shell that runs docker compose for this project. Nightly dumps + the offsite copy are shared-services' job.
DUSU_MONGO_PASSWORD=change-me-to-the-password-from-dusu-prod.env

# dusu.ruralrootcloud.com is routed by the host's own cloudflared (already
# running as a systemd service on this box) straight to
# http://localhost:${BACKEND_PORT}. No token/tunnel var needed in this repo —
# see cloudflare/TUNNEL.md for the one-time dashboard route setup.
