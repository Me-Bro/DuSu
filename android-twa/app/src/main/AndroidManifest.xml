<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility: needed to bind to Chrome's Custom Tabs service -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DuSuTWA">

        <!-- Digital Asset Links statement: declares this app trusts the DuSu web origin.
             The site must serve the matching /.well-known/assetlinks.json for full-screen
             (no address bar). Until verified it still opens, inside a Custom Tab bar. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- Entry point: checks connectivity, shows an offline screen if needed, then
             launches the TWA. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.DuSuTWA">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Trusted Web Activity itself (started by MainActivity). Not the launcher. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:screenOrientation="portrait">

            <!-- The site DuSu opens full-screen -->
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launchUrl" />

            <!-- Status / navigation bar tint = DuSu dark background -->
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/twaBackground" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/twaBackground" />

            <!-- If Chrome / a TWA-capable browser is missing, fall back to a Custom Tab -->
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="customtabs" />

            <!-- Open the DuSu origin in-app -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="@string/hostName" />
            </intent-filter>
        </activity>

        <!-- Notification delegation: Chrome hands the site's web-push notifications to THIS app, so they appear
             as DuSu notifications (DuSu icon, DuSu's Android notification permission and settings page) instead of
             "Chrome". It only works while the site is verified for this app (assetlinks.json), which is also what
             removes the browser bar. TwaLauncher (used by MainActivity) stores the token this service checks. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_notification_icon" />
            <!-- reminders should pop up as a banner, not wait silently in the shade -->
            <meta-data
                android:name="androidx.browser.trusted.USE_HIGH_PRI_NOTIFICATIONS"
                android:value="true" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Brings the TWA back to the front when a notification is tapped -->
        <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />

        <!-- Shows Android 13+'s notification permission dialog when the web page asks for it -->
        <activity android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity" />
    </application>
</manifest>
