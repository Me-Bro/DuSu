# Copy to .env and fill in. backend/.env is git-ignored — never commit real keys.

# --- LLM provider chain (OpenAI-compatible; empty keys are skipped) ---
# Every provider below speaks the OpenAI Chat Completions shape, so one client
# drives them all. app/config.py providers() tries them IN THIS ORDER and fails
# over on 429/quota: groq -> gemini -> openrouter -> github. Model names per
# provider live in config.py, not here (they get retired without notice).
# Speech-to-text and text-to-speech run in the browser — free, no key.
#
# Groq — first in the chain: free and fastest (~0.7s/turn). console.groq.com/keys
GROQ_API_KEY=gsk_...
# Gemini — free ~1500/day. Get an API key at aistudio.google.com/apikey.
# NOTE: an AI Studio API key starts with "AIza". An "AQ."-prefixed value is an
# OAuth token, not an API key, and the endpoint rejects it with HTTP 401.
GEMINI_API_KEY=AIza...
# OpenRouter — free ~50/day, heavily rate-limited, so it sits late in the chain.
OPENROUTER_API_KEY=sk-or-v1-...
# GitHub Models — the token needs the "models" permission.
# NOTE: GitHub Models is being retired; it currently answers HTTP 410 (brownout).
GITHUB_TOKEN=github_pat_...

# --- Google Sign-In (login is enabled whenever this is set) ---
# Create an OAuth 2.0 Web client at console.cloud.google.com:
#   APIs & Services → Credentials → Create Credentials → OAuth client ID
#   Application type: Web application
#   Authorized JavaScript origins: every origin the app is served from, e.g.
#     http://localhost:3878  and  https://dusu.ruralrootcloud.com
# Leave empty to run with no login at all (dev only — most endpoints then 401).
GOOGLE_CLIENT_ID=
# Signs DuSu session tokens AND (via the KEYS_SECRET fallback in db.py) seals
# stored BYOK keys at rest. Use a long random string; changing it invalidates
# every live login and every stored user key.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
# DuSu's database is this stack's own `db` container (see docker-compose.yml).
# compose builds DATABASE_URL from the POSTGRES_* vars in the ROOT .env and
# injects it, overriding anything set here — leave both blank for a docker run.
# There is no external/managed provider; `docker compose up` brings up Postgres.
#
# Set these two ONLY to run the backend outside docker (you must then publish the
# db port in docker-compose.yml and point at localhost). Empty DATABASE_URL =
# the app runs fully but STATELESS: no users, progress, memory or stored keys.
DATABASE_URL=
# Postgres on the compose network serves no TLS cert. Only a provider that
# demands TLS would need this true.
DATABASE_SSL=false

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Android TWA (Digital Asset Links) ---
# Required for the Play Store app to render full-screen (no Chrome address
# bar). Without it, GET /.well-known/assetlinks.json serves an empty
# fingerprint list, Chrome can't verify the app owns this site, and it falls
# back to a Custom Tab with the URL bar showing — permanently, until this is set.
# Get the SHA-256 via: keytool -list -v -keystore <your>.jks -alias <alias>
# Comma-separate multiple (e.g. upload key AND Play App Signing key).
ANDROID_CERT_SHA256=
# Defaults to com.dusu.app if unset — only change if you rename the package.
ANDROID_TWA_PACKAGE=
